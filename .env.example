# Copy this file to .env and fill only the providers you actually use.
# Never commit .env or paste real key values into issues, PRs, logs, or chat.

# ASI:One upstream for bounded Omega benchmarks.
ASIONE_API_KEY=

# ASI Cloud upstream for bounded Omega benchmarks.
ASI_API_KEY=

# OpenRouter upstream for bounded Omega benchmarks and image perception.
OPENROUTER_API_KEY=

# OpenAI upstream for bounded Omega benchmarks.
OPENAI_API_KEY=

# Generic OpenAI-compatible upstream. Also requires --openaiapi-url at runtime.
OPENAIAPI_API_KEY=
